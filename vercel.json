{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/omdb.js": {
      "maxDuration": 15
    },
    "api/auth.js": {
      "maxDuration": 20
    },
    "api/library.js": {
      "maxDuration": 20
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/$1" }]
}
